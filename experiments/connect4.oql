-- experiments/connect4.oql
-- E08 Phase 4 worked example.  Adapted from E08-oql-behaviours.md §1.3.2.
--
-- Pre-registered claim (E08 T2): this file + its four behaviour bodies
-- weigh in at ≤ 30% of the LOC cost of demos/character-level/connect4/main.c
-- (529 LOC).  Measurement in experiments/E08-oql-behaviours.md §3.4.
--
-- VM authoring caveat: the existing VM treats `return` as STACK_PUSH (not
-- early-exit), so every BEHAVIOUR body uses the single-return idiom — assign
-- to a result var inside any branches, return once at the end.  See
-- src/microgpt_vm_natives.h header note.
--
-- Numeric-handle ABI: the VM's vm_native_fn signature is double(int,double*).
-- Strings cross the boundary as integer handles into a host-side intern
-- table; see src/microgpt_vm_natives.{h,c}.

-- ──────────────────────────────────────────────────────────────────
-- INPUT_BEHAVIOUR — ask the model for a column proposal via the
-- C-demo prompt protocol, then collapse the result into a one-hot
-- legal mask the runtime can drop directly.
--
-- E11 Pathway B: the new extern c4_model_propose_column(temp_x100)
-- runs organelle_generate_ensemble against the loaded player
-- organelle with the corpus-encoded prompt
--   board=<42>|valid=<csv>
-- (matches demos/character-level/connect4/main.c lines 311-320 and
--  the training corpus c_connect4_player.txt verbatim).  Returns
-- the proposed column 0..6 or -1 on parse / no-model.
--
-- When the model proposes a legal column, we return (1 << col) so
-- the runtime's downstream sampler picks exactly that column.
-- When the model declines or proposes illegally, we fall back to
-- the full legal mask (E09 baseline) — the runtime then picks
-- uniformly and VALIDATE/FALLBACK behave as before.
-- ──────────────────────────────────────────────────────────────────
CREATE BEHAVIOUR parse_c4_board AS VM `
    declare function c4_legal_column_mask(): number;
    declare function c4_column_is_legal_n(col: number): number;
    declare function c4_model_propose_column(t: number): number;
    function eval(): number {
        var legal  = c4_legal_column_mask();
        var col    = c4_model_propose_column(20);
        var result = legal;
        if (col >= 0) {
            var ok = c4_column_is_legal_n(col);
            if (ok > 0) {
                /* One-hot mask: 1 << col, computed by repeated doubling
                 * because the VM TS dialect has no bit-shift operator. */
                var bit = 1;
                var i   = 0;
                while (i < col) {
                    bit = bit + bit;
                    i   = i + 1;
                }
                result = bit;
            }
        }
        return result;
    }
`;

-- ──────────────────────────────────────────────────────────────────
-- OUTPUT_BEHAVIOUR — extract the proposed column digit from the
-- model's most-recent next-token output
-- ──────────────────────────────────────────────────────────────────
CREATE BEHAVIOUR format_c4_move AS VM `
    declare function c4_parse_token(): number;
    function eval(): number {
        var col = c4_parse_token();
        return col;
    }
`;

-- ──────────────────────────────────────────────────────────────────
-- VALIDATE_BEHAVIOUR — true iff parsed move is a legal column drop
-- ──────────────────────────────────────────────────────────────────
CREATE BEHAVIOUR c4_move_is_legal AS VM `
    declare function c4_parse_token(): number;
    declare function c4_column_is_legal_n(col: number): number;
    function eval(): number {
        var col = c4_parse_token();
        var ok  = 0;
        if (col >= 0) {
            ok = c4_column_is_legal_n(col);
        }
        return ok;
    }
`;

-- ──────────────────────────────────────────────────────────────────
-- FALLBACK_BEHAVIOUR — when entropy is high, prefer the centre column;
-- otherwise -1 (defer to the model)
-- ──────────────────────────────────────────────────────────────────
CREATE BEHAVIOUR c4_fallback_when_stuck AS VM `
    declare function c4_last_entropy(): number;
    declare function c4_centre_col(): number;
    declare function c4_column_is_legal_n(col: number): number;
    function eval(): number {
        var ent    = c4_last_entropy();
        var result = -1;
        if (ent > 0.8) {
            var cc    = c4_centre_col();
            var legal = c4_column_is_legal_n(cc);
            if (legal > 0) {
                result = cc;
            }
        }
        return result;
    }
`;

-- ──────────────────────────────────────────────────────────────────
-- ORGANELLE bindings — the player and planner share the parse/format
-- behaviours; only the player runs the VALIDATE/FALLBACK pair.
-- (TRAIN/COMPOSE/RUN remain stubbed in E07; the full game loop is
-- harness-driven for now — see test_e08_connect4_behaviours.)
-- ──────────────────────────────────────────────────────────────────
CREATE ORGANELLE connect4_player
  FROM CHECKPOINT 'checkpoints/c4_player.ckpt'
  WITH (
    INPUT_BEHAVIOUR    = parse_c4_board,
    OUTPUT_BEHAVIOUR   = format_c4_move,
    VALIDATE_BEHAVIOUR = c4_move_is_legal,
    FALLBACK_BEHAVIOUR = c4_fallback_when_stuck
  );

CREATE ORGANELLE connect4_planner
  FROM CHECKPOINT 'checkpoints/c4_planner.ckpt'
  WITH (
    INPUT_BEHAVIOUR  = parse_c4_board,
    OUTPUT_BEHAVIOUR = format_c4_move
  );

-- ──────────────────────────────────────────────────────────────────
-- COMPOSE — wire the player + planner as a two-stage linear pipeline.
-- E09 Phase 2: the linear FROM form resolves each name to an
-- OqlOrganelle entry; no inline @graph block needed for this game.
--
-- E11 Gap-B fix: PLAYER is listed FIRST so the game-loop runtime
-- (oql_run_game_loop, which takes call_organelles[0] as the move
-- source) loads c4_player.ckpt and runs inference against player
-- data.  Pre-E11 the planner was first and its checkpoint was loaded
-- as the move source — that was Gap B in E11-diagnosis.md.
-- ──────────────────────────────────────────────────────────────────
COMPOSE connect4_pipeline
  FROM connect4_player, connect4_planner;

-- ──────────────────────────────────────────────────────────────────
-- RUN — drive the pipeline against a random opponent over 100 games.
-- E09 Phase 3: oql_run_game_loop dispatches each turn through
-- INPUT_BEHAVIOUR → forward_inference → OUTPUT_BEHAVIOUR →
-- VALIDATE_BEHAVIOUR → (FALLBACK_BEHAVIOUR if invalid), then applies
-- the move to the host's Connect-4 board.  When the player's checkpoint
-- is absent or fails to load, the runtime degrades to random-vs-random
-- so the wiring still executes end-to-end (T1) and reports a metric row;
-- T2 (win rate) is only meaningful with a trained checkpoint — see
-- experiments/E09-oql-runtime-wiring.md §3.4.
-- ──────────────────────────────────────────────────────────────────
RUN connect4_pipeline WITH
  MODE     = game_loop,
  GAME     = connect4,
  OPPONENT = random,
  GAMES    = 100,
  SEED     = 42;
